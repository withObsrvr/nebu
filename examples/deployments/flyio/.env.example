# Example Environment Variables for Local Development
# Copy this file to .env and customize for your setup

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nebu:nebu_local_password@localhost:5432/nebu_indexer

# =============================================================================
# Stellar Configuration
# =============================================================================

# Stellar RPC endpoint
# Mainnet: https://archive-rpc.lightsail.network
# Testnet: https://soroban-testnet.stellar.org
RPC_URL=https://archive-rpc.lightsail.network

# Optional: RPC authentication token (if using authenticated endpoint)
# RPC_AUTH_TOKEN=your_token_here

# =============================================================================
# Indexer Configuration
# =============================================================================

# Starting ledger sequence
# Use "latest" to start from current ledger
# Use specific number (e.g., "60000000") for historical backfill
START_LEDGER=latest

# Batch size for postgres-sink (number of events per database commit)
# Higher = better throughput, but higher memory usage
# Range: 100-10000, recommended: 1000
BATCH_SIZE=1000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# Backfill Configuration
# =============================================================================

# Chunk size for backfill (number of ledgers per chunk)
# Smaller chunks = more frequent progress updates
# Larger chunks = faster overall backfill
CHUNK_SIZE=10000

# Skip confirmation prompts during backfill
SKIP_CONFIRMATION=false
