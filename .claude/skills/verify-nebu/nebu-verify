#!/usr/bin/env bash
# nebu-verify — isolated harness for driving the real nebu CLI.
#
# Every subcommand resolves one run directory and one evidence directory, so
# `up`, `doctor`, `run`, and `down` can be separate shell invocations.
#
#   run root (disposable):  $TMPDIR/nebu-verify/<run-id>/{bin,cache,work}
#   evidence  (survives):   <repo>/.verify-artifacts/<run-id>/
#   fixtures  (shared):     <repo>/.verify-artifacts/fixtures/
#
# Run `nebu-verify help` for usage.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")" && git rev-parse --show-toplevel)"
ARTIFACTS="$REPO/.verify-artifacts"
FIXTURES="$ARTIFACTS/fixtures"
POINTER="$ARTIFACTS/current"

# The public Stellar archive on S3. Used instead of RPC for anything that is
# not itself an assertion about RPC: the default endpoint refuses the third
# getLedgers call in a burst with 429.
ARCHIVE_FLAGS=(--mode archive --datastore-type S3
  --bucket-path aws-public-blockchain/v1.1/stellar/ledgers/pubnet
  --region us-east-2)

DEFAULT_PROCESSORS="token-transfer usdc-filter json-file-sink"
DEFAULT_FIXTURE_START=60200000
DEFAULT_FIXTURE_END=60200004

die() { printf 'nebu-verify: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

resolve_run() {
  if [[ -n "${NEBU_VERIFY_RUN:-}" ]]; then
    RUN="$NEBU_VERIFY_RUN"
  elif [[ -f "$POINTER" ]]; then
    RUN="$(cat "$POINTER")"
  else
    die "no current run. Start one with: nebu-verify up"
  fi
  ROOT="${TMPDIR:-/tmp}/nebu-verify/$RUN"
  EVID="$ARTIFACTS/$RUN"
}

# Loads the environment `up` recorded. Keep every variable here identical to
# what `up` wrote, or a later step runs against a different installation than
# the one doctor checked.
load_env() {
  [[ -f "$ROOT/env.sh" ]] || die "run $RUN has no env.sh at $ROOT (was it torn down?)"
  # shellcheck disable=SC1091
  source "$ROOT/env.sh"
}

write_env() {
  cat > "$ROOT/env.sh" <<ENVEOF
# Generated by nebu-verify up. Source this to drive run $RUN by hand.
export NEBU_VERIFY_RUN="$RUN"
export NEBU_VERIFY_ROOT="$ROOT"
export NEBU_VERIFY_EVIDENCE="$EVID"
export NEBU_VERIFY_FIXTURES="$FIXTURES"
export NEBU_VERIFY_MODE="$MODE"
export NEBU_VERIFY_EXPECTED_VERSION="$EXPECTED_VERSION"
# Isolation: binaries, registry cache, and Go build scope all live in the run root.
export GOBIN="$ROOT/bin"
export PATH="$ROOT/bin:\$PATH"
export XDG_CACHE_HOME="$ROOT/cache"
export GOWORK=off
# Off EC2 the AWS credential chain waits out the instance metadata service
# (~10s per process) before the anonymous fallback a public bucket needs.
export AWS_EC2_METADATA_DISABLED=true
# DuckDB 2.0.0 collapses read_json's inferred schema to a single \`json\`
# column when AI_AGENT or CLAUDECODE is set and stdout is not a terminal, so
# a documented query like SELECT transfer becomes a binder error. Pinned off
# here so these checks mean the same thing for a person and for an agent.
export DUCKDB_AGENT_MODE=0
ENVEOF
}

next_step_index() {
  local n
  n="$(find "$EVID/steps" -maxdepth 1 -name '[0-9][0-9][0-9]-*.exit' 2>/dev/null | wc -l)"
  printf '%03d' "$((n + 1))"
}

# capture <name> <mode:exec|shell> <args...>
# Writes .cmd/.out/.err/.exit under the evidence dir and prints a summary.
# Never aborts the caller on a nonzero exit: the exit code is evidence.
capture() {
  local name="$1" mode="$2"; shift 2
  local idx base
  idx="$(next_step_index)"
  base="$EVID/steps/$idx-$name"
  local status=0
  if [[ "$mode" == shell ]]; then
    printf '%s\n' "$1" > "$base.cmd"
    set +e
    ( cd "$ROOT/work" && bash -o pipefail -c "$1" ) > "$base.out" 2> "$base.err"
    status=$?
    set -e
  else
    printf '%q ' "$@" > "$base.cmd"; printf '\n' >> "$base.cmd"
    set +e
    ( cd "$ROOT/work" && "$@" ) > "$base.out" 2> "$base.err"
    status=$?
    set -e
  fi
  printf '%s\n' "$status" > "$base.exit"
  local lines bytes
  lines="$(wc -l < "$base.out")"
  bytes="$(wc -c < "$base.out")"
  info "step $idx-$name: exit=$status stdout=${lines}L/${bytes}B evidence=$base.{cmd,out,err,exit}"
  if [[ "$status" -ne 0 ]]; then
    info "--- stderr tail ---"
    tail -n 15 "$base.err" >&2 || true
    info "-------------------"
  fi
  return "$status"
}

cmd_up() {
  MODE=published
  local version=latest
  local processors="$DEFAULT_PROCESSORS"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --published) MODE=published; shift ;;
      --local)     MODE=local; shift ;;
      --version)   version="${2:?--version needs a value}"; shift 2 ;;
      --processors) processors="${2:?--processors needs a space-separated list}"; shift 2 ;;
      *) die "up: unknown argument $1" ;;
    esac
  done

  RUN="${NEBU_VERIFY_RUN:-$(date +%Y%m%d-%H%M%S)-$$}"
  ROOT="${TMPDIR:-/tmp}/nebu-verify/$RUN"
  EVID="$ARTIFACTS/$RUN"
  [[ -e "$ROOT" ]] && die "run root already exists: $ROOT"

  mkdir -p "$ROOT/bin" "$ROOT/cache" "$ROOT/work" "$EVID/steps" "$FIXTURES"
  EXPECTED_VERSION="$version"
  write_env
  load_env
  printf '%s\n' "$RUN" > "$POINTER"

  info "run $RUN"
  info "  root     $ROOT"
  info "  evidence $EVID"
  info "  mode     $MODE"

  if [[ "$MODE" == published ]]; then
    # The shipped artifact: what `go install ...@latest` hands a user. Run
    # from the run root, never the repo, so nothing resolves to local source.
    capture install-nebu exec go install "github.com/withObsrvr/nebu/cmd/nebu@$version" \
      || die "installing the published nebu failed; see the evidence dir"
  else
    # A local build is NOT the shipped artifact. Use it only to check an
    # uncommitted change, and say so in the proof.
    local ldflags
    ldflags="-X github.com/withObsrvr/nebu/pkg/version.Version=$(cd "$REPO" && git describe --tags --always --dirty 2>/dev/null || echo dev)"
    capture build-nebu shell "cd '$REPO' && go build -ldflags '$ldflags' -o '$ROOT/bin/nebu' ./cmd/nebu" \
      || die "building nebu from this checkout failed; see the evidence dir"
  fi

  [[ -x "$ROOT/bin/nebu" ]] || die "nebu is not at $ROOT/bin/nebu after install"
  "$ROOT/bin/nebu" --version > "$ROOT/installed-version.txt" 2>&1
  info "  installed $(cat "$ROOT/installed-version.txt")"

  # Processors go in through the documented user path: `nebu install <name>`.
  # It runs `go install <pkg>@latest` and does NOT pass --path to it, so GOBIN
  # is what actually decides where the binary lands (cmd/nebu/install.go:160).
  for p in $processors; do
    capture "install-$p" exec nebu install "$p" \
      || die "nebu install $p failed; see the evidence dir"
    [[ -x "$ROOT/bin/$p" ]] || die "nebu install $p reported success but $ROOT/bin/$p does not exist"
  done
  printf '%s\n' "$processors" > "$ROOT/processors.txt"

  info "up complete. Next: nebu-verify doctor"
}

cmd_doctor() {
  resolve_run; load_env
  local fails=0
  check() {
    local label="$1"; shift
    if "$@" > /dev/null 2>&1; then
      printf 'PASS  %s\n' "$label"
    else
      printf 'FAIL  %s\n' "$label"
      fails=$((fails + 1))
    fi
  }

  printf 'doctor: run %s (mode %s)\n' "$RUN" "$NEBU_VERIFY_MODE"
  printf 'root     %s\n' "$ROOT"
  printf 'evidence %s\n' "$EVID"

  # Is this the instance we built? A nebu found anywhere else is someone
  # else's installation and must not be driven.
  local resolved
  resolved="$(command -v nebu || true)"
  printf 'nebu     %s\n' "${resolved:-<not found>}"
  check "nebu resolves inside the run root" test "$resolved" = "$ROOT/bin/nebu"
  check "nebu --version exits 0 and prints a version" \
    bash -c 'nebu --version | grep -Eq "nebu version v?[0-9]+\.[0-9]+\.[0-9]+"'
  printf 'version  %s\n' "$(nebu --version 2>&1 || true)"

  # `nebu list` warns to stderr and still exits 0 when the external registry
  # is unreachable (pkg/registry/registry.go:238), so exit 0 proves nothing.
  # Usable means the community catalog actually arrived.
  check "nebu list reaches the external registry (nothing on stderr)" \
    bash -c '[ -z "$(nebu list 2>&1 >/dev/null)" ]'
  check "nebu list returns community processors" \
    bash -c 'nebu list 2>/dev/null | grep -q "\[community\]"'
  check "registry cache is populated under the run root" \
    bash -c '[ -n "$(find "$XDG_CACHE_HOME/nebu/registries" -type f 2>/dev/null | head -1)" ]'

  # Every processor must be ours, runnable, and describable without flags.
  local processors
  processors="$(cat "$ROOT/processors.txt" 2>/dev/null || echo "")"
  for p in $processors; do
    check "$p is installed in the run root" test -x "$ROOT/bin/$p"
    check "$p resolves to the run root copy" bash -c "[ \"\$(command -v $p)\" = \"$ROOT/bin/$p\" ]"
    # PROCESSOR_CONTRACT.md:113 — origins and transforms carry schema.id;
    # a sink legitimately reports an empty schema object, so requiring an id
    # for every processor fails json-file-sink on a working installation.
    check "$p --describe-json names itself, exits 0, and carries a schema id unless it is a sink" \
      bash -c "$p --describe-json | jq -e '.name == \"$p\" and (if .type == \"sink\" then true else (.schema.id | type == \"string\") end)'"
  done

  for t in jq duckdb; do
    check "$t is on PATH" command -v "$t"
  done

  if [[ -n "$(find "$FIXTURES" -name '*.xdr' -size +0 2>/dev/null | head -1)" ]]; then
    printf 'PASS  ledger fixtures present in %s\n' "$FIXTURES"
  else
    printf 'WARN  no ledger fixtures yet; run: nebu-verify fixture\n'
  fi

  if [[ "$fails" -ne 0 ]]; then
    printf '\ndoctor: %d check(s) failed. This instance is not worth driving.\n' "$fails"
    return 1
  fi
  printf '\ndoctor: all checks passed.\n'
}

cmd_fixture() {
  resolve_run; load_env
  local start="${1:-$DEFAULT_FIXTURE_START}" end="${2:-$DEFAULT_FIXTURE_END}"
  local out="$FIXTURES/ledgers-$start-$end.xdr"
  if [[ -s "$out" ]]; then
    info "fixture already present: $out ($(wc -c < "$out") bytes)"
    printf '%s\n' "$out"
    return 0
  fi
  info "fetching ledgers $start..$end from the public archive"
  capture "fixture-$start-$end" exec nebu fetch "${ARCHIVE_FLAGS[@]}" "$start" "$end" --output "$out" \
    || die "archive fetch failed; see the evidence dir"
  [[ -s "$out" ]] || die "archive fetch exited 0 but produced an empty file: $out"
  info "fixture ready: $out ($(wc -c < "$out") bytes)"
  printf '%s\n' "$out"
}

cmd_run() {
  resolve_run; load_env
  local name="${1:?run needs a step name}"; shift
  [[ "${1:-}" == -- ]] || die "run: expected -- before the command"
  shift
  capture "$name" exec "$@"
}

cmd_sh() {
  resolve_run; load_env
  local name="${1:?sh needs a step name}"; shift
  [[ "${1:-}" == -- ]] || die "sh: expected -- before the pipeline"
  shift
  capture "$name" shell "$*"
}

# Long-running commands (`--follow`) only. Records the PID so `down` can kill
# exactly what this run started, never a process matched by name.
cmd_bg() {
  resolve_run; load_env
  local name="${1:?bg needs a step name}"; shift
  [[ "${1:-}" == -- ]] || die "bg: expected -- before the command"
  shift
  local idx base
  idx="$(next_step_index)"
  base="$EVID/steps/$idx-$name"
  printf '%q ' "$@" > "$base.cmd"; printf '\n' >> "$base.cmd"
  ( cd "$ROOT/work" && "$@" ) > "$base.out" 2> "$base.err" &
  local pid=$!
  printf '%s %s\n' "$pid" "$name" >> "$EVID/pids"
  info "step $idx-$name: started pid=$pid evidence=$base.{out,err}"
  printf '%s\n' "$pid"
}

cmd_env() { resolve_run; cat "$ROOT/env.sh"; }

cmd_where() {
  resolve_run
  printf 'run       %s\nroot      %s\nevidence  %s\nfixtures  %s\n' "$RUN" "$ROOT" "$EVID" "$FIXTURES"
}

cmd_down() {
  resolve_run
  if [[ -f "$EVID/pids" ]]; then
    while read -r pid _; do
      [[ -n "$pid" ]] || continue
      if kill -0 "$pid" 2>/dev/null; then
        info "killing pid $pid started by this run"
        kill "$pid" 2>/dev/null || true
      fi
    done < "$EVID/pids"
    rm -f "$EVID/pids"
  fi
  if [[ -d "$ROOT" ]]; then
    rm -rf "$ROOT"
    info "removed run root $ROOT"
  fi
  # The evidence dir and the shared fixtures are deliberately left behind.
  if [[ -f "$POINTER" && "$(cat "$POINTER")" == "$RUN" ]]; then
    rm -f "$POINTER"
  fi
  info "evidence kept at $EVID"
}

cmd_help() {
  cat <<'USAGE'
nebu-verify — isolated harness for driving the real nebu CLI

  up [--published|--local] [--version VER] [--processors "a b c"]
        Create the run root and install nebu plus processors into it.
        --published (default) installs go install <nebu>@VER — the shipped
        artifact. --local builds this checkout and is NOT what users get.
  doctor
        Read-only: is this instance worth driving?
  fixture [START END]
        Fetch a ledger range once from the public S3 archive into the shared
        fixture dir. Idempotent. Defaults to 60200000..60200004.
  run <step> -- <cmd> [args...]
        Run one command in the isolated env; capture cmd/out/err/exit.
  sh <step> -- '<pipeline>'
        Same, through bash -o pipefail -c, for pipes and redirects.
  bg <step> -- <cmd> [args...]
        Start a long-running command, record its PID for teardown.
  env | where
        Print the recorded environment / the run's paths.
  down
        Kill PIDs this run started, remove the run root, keep the evidence.

Set NEBU_VERIFY_RUN to address a specific run; otherwise the newest `up`
wins via .verify-artifacts/current.
USAGE
}

case "${1:-help}" in
  up) shift; cmd_up "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  fixture) shift; cmd_fixture "$@" ;;
  run) shift; cmd_run "$@" ;;
  sh) shift; cmd_sh "$@" ;;
  bg) shift; cmd_bg "$@" ;;
  env) shift; cmd_env "$@" ;;
  where) shift; cmd_where "$@" ;;
  down) shift; cmd_down "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown subcommand ${1}. Run: nebu-verify help" ;;
esac
